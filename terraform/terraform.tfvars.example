# Copy this file to terraform.tfvars and fill in your Oracle Cloud details:
# cp terraform.tfvars.example terraform.tfvars

tenancy_ocid     = "ocid1.tenancy.oc1..your_tenancy_ocid"
user_ocid        = "ocid1.user.oc1..your_user_ocid"
compartment_ocid = "ocid1.tenancy.oc1..your_compartment_ocid"

region           = "us-ashburn-1" # e.g. us-ashburn-1, us-phoenix-1
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
ssh_public_key   = "ssh-ed25519 AAAAC3... your_ssh_public_key"
